+        if (!impl_ || !impl_->loaded) {
+            return PhysicsSandboxResult<PhysicsSandboxSceneView>::Failure(
+                    SandboxError(PhysicsSandboxErrorCode::InvalidSandbox,
+                                 "sandbox has no loaded scene"));
