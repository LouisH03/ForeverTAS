+                !IsAnalogInputStateValid(event.value.analog)) {
+                return PhysicsSandboxResult<std::size_t>::Failure(
+                        SandboxError(PhysicsSandboxErrorCode::InvalidRequest,
+                                     "sandbox input window contains an invalid analog value"));
+            }
