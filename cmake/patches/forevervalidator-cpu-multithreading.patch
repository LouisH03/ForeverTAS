+                    baselineLast, baseInputs->end(),
+                    [action](const PhysicsSandboxInputEvent &event) {
+                        if (action == PhysicsSandboxInputAction::Accelerate) {
+                            return event.action ==
+                                           PhysicsSandboxInputAction::Accelerate ||
+                                    event.action ==
+                                           PhysicsSandboxInputAction::Gas;
+                        }
