{
  "version": 3,
  "configurePresets": [
    {
      "name": "pinned",
      "displayName": "Pinned ForeverValidator",
      "description": "Build against the exact ForeverValidator commit pinned by CMakeLists.txt.",
      "binaryDir": "${sourceDir}/build/pinned",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "FOREVERVALIDATOR_ENABLE_RELEASE_IPO": "OFF",
        "FOREVERVALIDATOR_CUDA_SPLIT_COMPILE_JOBS": "4"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "pinned",
      "configurePreset": "pinned",
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "pinned",
      "configurePreset": "pinned",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 4
      }
    }
  ]
}
